# HYPERLIQUID_PRIVATE_KEY: The private key for your trading wallet.
# DO NOT COMMIT REAL KEYS.
HYPERLIQUID_PRIVATE_KEY=""
HYPERLIQUID_WALLET_ADDRESS=""
# Optional: trade on behalf of a vault/subaccount (master wallet signs).
# HYPERLIQUID_VAULT_ADDRESS=""
# Optional: reject signed actions after this timestamp (ms). See Hyperliquid `expiresAfter` docs.
# HYPERLIQUID_EXPIRES_AFTER_MS=

# Operational Modes
DRY_RUN=true
TESTNET=true
LIVE_TRADING=false
USE_TOP_PAIRS_ONLY=true
# Top volume pairs tracked by the Hyper System (clamped 5–10). Default in code is 8.
TOP_TRADING_PAIRS=8
SIGNAL_LOOKBACK_DAYS=60

# Hyperstrong auto-trading (server): set HYPER_SIGNAL_TRADING=true with LIVE_TRADING + keys to place Ioc orders on aligned signals.
# HYPER_SIGNAL_TRADING=false
# HYPER_STRONG_SCORE_MIN=3
# HYPER_MOMENTUM_MIN_PCT=0.08
# HYPER_ORDER_NOTIONAL_USD=15
# HYPER_COOLDOWN_MS=120000
# HYPER_TREND_CACHE_MS=180000
# HYPER_PAIR_REFRESH_MS=120000
# HYPER_MIDS_DEBOUNCE_MS=250
# HYPER_MOMENTUM_WINDOW_MS=90000

DB_PATH="trading_bot.db"

# GEMINI_API_KEY: Required for Gemini AI API calls (if any).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
