# HYPERLIQUID_PRIVATE_KEY: The private key for your trading wallet.
# DO NOT COMMIT REAL KEYS.
HYPERLIQUID_PRIVATE_KEY=""
HYPERLIQUID_WALLET_ADDRESS=""

# Operational Modes
DRY_RUN=true
TESTNET=true
LIVE_TRADING=false
DB_PATH="trading_bot.db"

# GEMINI_API_KEY: Required for Gemini AI API calls (if any).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Market Selection
MARKET_SELECTION_ENABLED=false
MARKET_SELECTION_INTERVAL_MINUTES=60
MAX_SELECTED_MARKETS=5
MIN_24H_VOLUME_USD=50000000
MAX_SPREAD_PERCENT=0.05
MAX_ABS_FUNDING_RATE=0.0003
MARKET_LOOKBACK_DAYS=60
