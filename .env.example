# HYPERLIQUID_PRIVATE_KEY: The private key for your trading wallet.
# DO NOT COMMIT REAL KEYS.
HYPERLIQUID_PRIVATE_KEY=""
HYPERLIQUID_WALLET_ADDRESS=""

# Operational Modes
DRY_RUN=true
TESTNET=true
LIVE_TRADING=false

# GEMINI_API_KEY: Required for Gemini AI API calls (if any).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
