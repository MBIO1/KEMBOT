# Telegram Configuration
VITE_TELEGRAM_BOT_TOKEN=
VITE_TELEGRAM_CHAT_ID=

# Hyperliquid trading configuration
# Defaults are intentionally safe: testnet + dry-run unless you explicitly set these to false.
HYPERLIQUID_PRIVATE_KEY=
HYPERLIQUID_WALLET_ADDRESS=
# Optional vault/subaccount address.
HYPERLIQUID_VAULT_ADDRESS=
# Optional exchange action expiry timestamp in ms.
HYPERLIQUID_EXPIRES_AFTER_MS=

TESTNET=true
DRY_RUN=true
LIVE_TRADING=false

# Set all three below only when you intentionally want real mainnet orders:
# TESTNET=false
# DRY_RUN=false
# LIVE_TRADING=true
