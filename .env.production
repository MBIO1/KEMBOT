# ============ PRODUCTION ENVIRONMENT - LIVE TRADING ON HYPERLIQUID ============
# 
# ⚠️ CRITICAL: This file contains REAL trading credentials
# Never commit to version control - use .env.production.local or secrets management
# Rotate credentials immediately if exposed
#

# ============ HYPERLIQUID ACCOUNT (REQUIRED FOR LIVE TRADING) ============
# Get these from your Hyperliquid account settings
# Private key should be the hex string of your trading account private key
# Wallet address is your trading account public address

HYPERLIQUID_PRIVATE_KEY=<your-private-key-hex>
HYPERLIQUID_WALLET_ADDRESS=<your-wallet-address>

# Optional: Use a vault/subaccount (recommended for fund safety)
# The master key will sign orders for the vault
HYPERLIQUID_VAULT_ADDRESS=

# Optional: Set expiration timeout for orders (milliseconds)
HYPERLIQUID_EXPIRES_AFTER_MS=

# ============ NETWORK CONFIGURATION ============
# Set all three for MAINNET LIVE TRADING
# OR set TESTNET=true for paper trading

TESTNET=false              # false = use mainnet URLs
DRY_RUN=false             # false = execute real orders
LIVE_TRADING=true         # true = enable live mode (required for real orders)

# ⚠️ Set all three above ONLY when you're ready for real money trading

# ============ RISK MANAGEMENT (CRITICAL - PREVENTS BLOWOUTS) ============

# Maximum USD value per single position
# Example: $2,000 per coin (BTC, ETH, etc.)
MAX_POSITION_SIZE_USD=2000

# Maximum total USD exposure across all positions
# Example: $10,000 (limits leverage implicitly)
MAX_TOTAL_EXPOSURE_USD=10000

# Maximum leverage allowed (1 = spot, 5 = max on Hyperliquid)
# Recommended: 2 (very safe)
MAX_LEVERAGE_ALLOWED=2

# Daily loss limit - stop trading if losses exceed this
# Example: $500 loss/day triggers trading halt
DAILY_LOSS_LIMIT_USD=500

# Minimum balance alert threshold (USDC)
# Warns if available balance drops below this
MIN_BALANCE_ALERT_USD=100

# ============ ORDER EXECUTION LIMITS ============

# Maximum allowed slippage percentage
# Example: 0.5% means orders can slip up to 0.5% from current price
MAX_SLIPPAGE_PERCENT=0.5

# Minimum milliseconds between consecutive orders
# Example: 1000ms = max 1 order/second (prevents API abuse)
ORDER_RATE_LIMIT_MS=1000

# Maximum open orders per symbol
MAX_OPEN_ORDERS_PER_SYMBOL=3

# ============ STRATEGY CONFIGURATION ============

# DCA Strategy
DCA_INTERVAL_MS=3600000     # How often to buy (ms). 3600000 = 1 hour
DCA_ORDER_SIZE_USD=100      # USD amount per DCA buy

# Grid Strategy
GRID_INTERVAL_MS=300000     # 5 minutes between grid orders
GRID_ORDER_SIZE_USD=50      # USD amount per grid order
GRID_LEVEL_COUNT=10         # Number of grid levels (not used yet)

# Signal Trading
HYPER_SIGNAL_TRADING=false  # Enable automated signal-based trading
HYPER_STRONG_SCORE_MIN=3    # Min trend score to trade
HYPER_MOMENTUM_MIN_PCT=0.08 # Min % momentum confirmation

# ============ MARKET SELECTION ============

MARKET_SELECTION_ENABLED=false
MARKET_SELECTION_INTERVAL_MINUTES=60
MAX_SELECTED_MARKETS=5
MIN_24H_VOLUME_USD=50000000
MAX_SPREAD_PERCENT=0.05
MAX_ABS_FUNDING_RATE=0.0003
MARKET_LOOKBACK_DAYS=60

# ============ TOP PAIRS CONFIGURATION ============

TOP_TRADING_PAIRS=8           # Top N pairs by volume (clamped 5-10)
USE_TOP_PAIRS_ONLY=false     # Only trade top pairs
SIGNAL_LOOKBACK_DAYS=60

# ============ MONITORING & ALERTS ============

# Telegram (optional notifications)
VITE_TELEGRAM_BOT_TOKEN=<your-bot-token>
VITE_TELEGRAM_CHAT_ID=<your-chat-id>

# API Authentication for the web dashboard
# Generate a strong token for API auth
API_AUTH_TOKEN=<generate-strong-random-token>

# ============ DATABASE ============
DB_PATH=trading_bot.db

# ============ EMERGENCY ============
# When true, enables manual emergency close all positions button
ENABLE_EMERGENCY_CLOSE=true
